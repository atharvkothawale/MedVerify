# Root Environment Variables Example
# Copy to .env and fill in your details for Sepolia deployment.
# NEVER commit your actual .env file or private key to Git.

SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_sepolia_deployment_wallet_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Frontend Sepolia Config
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_SEPOLIA_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
